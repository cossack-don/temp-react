# Rsbuild инлайнит в бандл только переменные с префиксом PUBLIC_

# По умолчанию фронт ходит в локальный express: npm run server
# PUBLIC_API_URL=http://localhost:4000

# Внешний тестовый API, если локальный сервер не поднят.
# У него нет created_at, дата в карточке поста просто не покажется.
# PUBLIC_API_URL=https://jsonplaceholder.typicode.com
