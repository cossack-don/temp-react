# ==========================================================================
# Локальная разработка. Rsbuild подхватывает этот файл автоматически,
# когда NODE_ENV=development — то есть на `npm run dev` и `npm run dev:mf`.
#
# Файл коммитится: секретов тут нет, только адреса локальных сервисов.
# Личные отклонения от общего — в .env.local, он в .gitignore.
# ==========================================================================

# Локальный Express на моках: npm run server
PUBLIC_API_URL=http://localhost:4000

# Откуда хост забирает remoteEntry.js в режиме микрофронтенда.
# Совпадает с портом из rsbuild.mf.config.ts.
PUBLIC_MF_URL=http://localhost:3001
