{
  "name": "template-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "____DOCS____": "",
    "dev:docs": "rspress dev",
    "build:docs": "rspress build",
    "preview:docs": "rspress preview",
    "____STYLE-GENERATE____": "",
    "styles:flex": "node scripts/css/generate-flex.mjs",
    "styles:margin": "node scripts/css/generate-margin.mjs",
    "styles:padding": "node scripts/css/generate-padding.mjs",
    "styles:grid": "node scripts/css/generate-grid.mjs",
    "___SINGLETONE-MODE____": "",
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "____MICROFRONTEND-MODE____": "",
    "dev:mf": "rsbuild dev --config rsbuild.mf.config.ts",
    "build:mf": "rsbuild build --config rsbuild.mf.config.ts",
    "preview:mf": "rsbuild preview --config rsbuild.mf.config.ts",
    "____API-SERVER____": "",
    "server": "tsx watch --import server/index.ts",
    "typecheck:server": "tsc --noEmit -p server",
    "____РАЗОБРАТЬ____": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "axios": "^1.17.0",
    "camelcase-keys": "^10.0.0",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.1",
    "rsuite": "^6.2.4",
    "snakecase-keys": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@module-federation/rsbuild-plugin": "^2.6.0",
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-typed-css-modules": "^1.2.0",
    "@rspress/core": "^2.0.21",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.90.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "express": "^5.2.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
